[Unit]
Description=nanoclaude - persistent Claude Code container (podman), standalone (no Dockhand)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutStopSec=30

# Podman's --health-on-failure=kill stops the container the moment the
# HEALTHCHECK reports unhealthy; that makes ExecStart exit, and systemd's
# Restart=always then brings it straight back up. Requires podman >= 4.3.
# Memory sized against a real 463MB-total Pi Zero 2 already running other
# services (~194MB used before this container starts) — see README's
# Tuning section. Adjust if your host's `free -m` headroom differs.
ExecStartPre=-/usr/bin/podman rm -f nanoclaude
ExecStart=/usr/bin/podman run --rm --name nanoclaude \
    --health-on-failure=kill \
    --memory=224m --memory-swap=448m \
    -e NODE_OPTIONS=--max-old-space-size=128 \
    -v nanoclaude-config:/home/claude/.claude \
    -v /var/lib/nanoclaude/workspace:/workspace \
    --env-file=/etc/nanoclaude/nanoclaude.env \
    ghcr.io/poag/nanoclaude:latest
ExecStop=/usr/bin/podman stop -t 10 nanoclaude

[Install]
WantedBy=multi-user.target
